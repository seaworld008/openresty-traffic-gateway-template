# 生产环境首次启动前，请先复制本文件：
#   cp .env.example .env
#
# 然后生成强随机密钥并写入 .env：
#   sed -i "s|^GATEWAY_QUEUE_SECRET=.*|GATEWAY_QUEUE_SECRET=$(openssl rand -base64 48 | tr -d '\n')|" .env
#   sed -i "s|^GATEWAY_OPS_TOKEN=.*|GATEWAY_OPS_TOKEN=$(openssl rand -base64 32 | tr -d '\n')|" .env

OPENRESTY_IMAGE=openresty/openresty:1.29.2.3-bookworm-fat
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=openresty

GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_DB=0
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_TIMEOUT_MS=1000
GATEWAY_METADATA_CACHE_TTL_SECONDS=10
GATEWAY_GRAY_FLAG_CACHE_TTL_SECONDS=2
GATEWAY_RESPONSE_REWRITE_MAX_BYTES=262144

# 等待室准入 token 签名密钥。
# 生产环境必须改成强随机值，所有 OpenResty 节点必须保持一致。
# 快速生成：
#   openssl rand -base64 48 | tr -d '\n'
GATEWAY_QUEUE_SECRET=change-this-before-production

# 等待室准入 cookie 名称。
# 通常保持默认即可；如果同一顶级域名下部署多套网关，可改成业务专属名称。
GATEWAY_ADMISSION_COOKIE_NAME=gw_admission

# 等待室运维接口令牌，用于访问 /api/ops/waitroom/summary 等运维端点。
# 生产环境必须改成强随机值，并只给可信运维系统或人员使用。
# 快速生成：
#   openssl rand -base64 32 | tr -d '\n'
GATEWAY_OPS_TOKEN=change-this-before-production
